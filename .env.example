# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase
# (Project Settings > API no painel do Supabase)

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA

# ── Monitoramento (aba "Monitoramento" — Disponibilidade/Geração/Combiners) ──
# Server-side only (sem prefixo VITE_, nunca vão pro bundle do cliente).
# Projeto Supabase DIFERENTE do de cima — usado só como cache dos dados do
# INGECON SUN Monitor. Sem essas variáveis, essas 3 sub-abas funcionam
# normalmente na interface mas as chamadas a /api/* falham (esperado em
# "vite dev" local; só "vercel dev" executa as funções serverless).
INGECON_API_KEY=
INGECON_PLANT_ID=ad493847-3dd7-4526-9122-123e35d1374a
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
